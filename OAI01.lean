    (K y d f E t c x₁ x₂ : ℝ)
    (hK : 0 < K) (hy : 0 < y) (hd : 0 < d)
    (hf : 0 < f) (hE : 0 < E) (ht : 0 < t)
    (hc : 0 < c) (hx₁ : 0 < x₁) (hx₂ : 0 < x₂) :
    K * y / (d * f ^ 2 * E * t ^ 2 * c * x₁ * x₂) =
      Real.exp (∑ j : Fin 9,
        firstCoeff j * firstLogs K y d f E t c x₁ x₂ j) := by
  rw [first_logsum, ← first_profile_logshape K y d f E t c x₁ x₂
