theorem quadraticCrossPhase_image
    {ι κ : Type*} [DecidableEq ι] [DecidableEq κ]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (e : κ → ι) (he : Function.Injective e)
