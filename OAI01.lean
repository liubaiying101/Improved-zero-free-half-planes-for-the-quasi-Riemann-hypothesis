  rw [hs', Complex.I_sq] at hquad
  norm_num at hquad
  exact hquad

theorem omega3_im : omega3.im = Real.sqrt 3 / 2 := by
  simp [omega3]

theorem omega3_im_ne_zero : omega3.im ≠ 0 := by
