theorem A3_ramified_inverse_left (u : R) :
    L (-u) * L u = (1 : Matrix (Fin 2) (Fin 2) R) := by
  rw [lower_add]
  simp [L, Matrix.one_fin_two]

theorem A3_ramified_matrix (a b c d u : R) :
    cuspMatrix a b c d * L (-u) =
