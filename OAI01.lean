theorem reflectedLogProfile_deriv_bound (logSource : SchwartzMap ℝ ℂ) (j : ℕ) (y : ℝ) :
    ‖iteratedDeriv j (reflectedLogProfile logSource) y‖ ≤
      (2 * Real.pi) ^ j * ∫ u : ℝ, ‖u‖ ^ j * ‖(𝓕 logSource) u‖ := by
