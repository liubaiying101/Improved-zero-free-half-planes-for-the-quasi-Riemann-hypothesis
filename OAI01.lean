        (↑(‖firstCoreInputRow p hg F D B v ε₁ ε₂ negative χ Ψ m H V y c d r t z‖ ^ 2) : ℂ)).re) -
      (‖H D‖ ^ 2 * ‖V (y D)‖ ^ 2) * ∫ t : ℝ, k t := by
