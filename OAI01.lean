    Complex.norm_of_nonneg (sq_nonneg _), Complex.norm_of_nonneg (le_of_lt hX), hmu, mul_one]
  calc
    _ ≤ Y * 1 * ‖eisEmbedding r‖ ^ 2 / X ^ 2 * ‖secondRayCoefficient z‖ := by gcongr
    _ = _ := by ring

