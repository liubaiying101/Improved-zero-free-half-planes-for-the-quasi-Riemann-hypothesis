      ∑ V ∈ F.powerset, secondCommonWeight p hp hcop hg Ψ₁ Ψ₂ m r c d e k₁ k₂ V *
        star (secondChildSum p hp hcop hg F V Ψ₁ m r c d e k₁ H₁) *
          secondChildSum p hp hcop hg F V Ψ₂ m r c d e k₂ H₂ := by
