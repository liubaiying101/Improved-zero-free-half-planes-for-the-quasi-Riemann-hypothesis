theorem from_mean_square_and_prime_rows
    (D ε J A : ℝ) (hD : 1 ≤ D) (hε : 0 ≤ ε)
    (hA : 0 ≤ A)
    (hJ : D ^ ((11 / 60 : ℝ) - ε) ≤ J)
    (hmean : J * A ^ 2 ≤
      2 * D ^ ((21 / 10 : ℝ) + ε) +
      2 * J * D ^ (49 / 30 : ℝ)) :
    A ≤ 2 * D ^ ((23 / 24 : ℝ) + ε) := by
