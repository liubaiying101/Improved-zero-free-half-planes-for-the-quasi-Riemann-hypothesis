  field_simp

theorem second_dyadic_profile
    (Y₀ k₀ d₀ e₀ v₀ n₁₀ n₂₀
      y k d e v n₁ n₂ : ℝ)
    (hY₀ : Y₀ ≠ 0) (hk₀ : k₀ ≠ 0) (hd₀ : d₀ ≠ 0)
