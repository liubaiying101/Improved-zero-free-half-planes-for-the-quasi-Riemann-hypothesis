  · congr 1
    simp only [map_mul, map_pow, map_neg]
    field_simp

theorem coprime_cross_numerator
    {R : Type*} [CommRing R] (a c₀ h r : R)
    (hfixed : IsCoprime a c₀)
    (hmoving : IsCoprime h r)
    (hmod : IsCoprime c₀ r) :
