  have h₁ := (secondRayMinus_norm_le Ψ₁ z (∏ i ∈ S, p i)).trans hΨ₁
  have h₂ := (secondRayPlus_norm_le Ψ₂ z (∏ i ∈ S, p i)).trans hΨ₂
  have hc' : ‖secondCommonWeight p hp hcop hg (secondRayMinus Ψ₁ z) (secondRayPlus Ψ₂ z)
