      Real.sqrt (D * (∑ u : Oˣ, ∑ z ∈ t,
        ‖idealChildRow p hp hcop hg F Ψ₁ m H₁ false u z‖ ^ 2)) := by
      gcongr
    _ = _ := by
      rw [Real.sqrt_mul hD, Real.sqrt_mul hD]
