        (∏ i ∈ D, Ideal.span {q i}) : ℝ) := by
    simp only [normCutoff, Finset.prod_union hHD, cutoffDifference, Complex.ofReal_sub]
    split_ifs <;> norm_num
  simp only [Finset.prod_union hHD, normalizedRow_mul]
  rw [← hc]
  ring

