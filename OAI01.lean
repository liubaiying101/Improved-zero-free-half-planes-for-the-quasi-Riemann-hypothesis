    quadraticGammaO (-traceLambda) (neg_ne_zero.mpr traceLambda_ne_zero) =
      quadraticGammaNegTraceLambda := by rfl

theorem quadraticGammaO_rational (m : ℕ) (hm : m ≠ 0)
