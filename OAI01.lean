    (rows : List (R × R)) (hc₀ : ι c₀ ≠ 0)
    (hp : ∀ ph ∈ rows, ι ph.1 ≠ 0) :
    ι (crossDen c₀ rows) ≠ 0 := by
  revert hp
  induction rows with
  | nil =>
      intro _
      simpa [crossDen] using hc₀
  | cons ph rows ih =>
      rcases ph with ⟨p, h⟩
      intro hp
      simp only [crossDen, map_mul]
      exact mul_ne_zero (ih (by
        intro ph hmem
        exact hp ph (List.mem_cons_of_mem _ hmem)))
        (hp (p, h) (List.mem_cons_self ..))

