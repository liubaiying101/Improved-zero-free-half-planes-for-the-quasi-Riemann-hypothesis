theorem second_profile_logshape
    (Y k d e v n₁ n₂ : ℝ)
    (hY : 0 < Y) (hk : 0 < k) (hd : 0 < d)
    (he : 0 < e) (hv : 0 < v)
    (hn₁ : 0 < n₁) (hn₂ : 0 < n₂) :
