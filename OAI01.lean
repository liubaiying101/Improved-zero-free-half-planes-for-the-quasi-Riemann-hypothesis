theorem same_ray_quadratic_pair_poisson
    {α ι : Type*} [DecidableEq α] [DecidableEq ι]
    (R : α → Ideal O) [∀ i, (R i).IsMaximal] (hinj : Function.Injective R) (S : Finset α)
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
