            (quotientProdEquivPi P hc) ψ i) := by
  let (i : ι) : Field (A ⧸ P i) := Ideal.Quotient.field (P i)
  exact gauss_transform_finite_crt (fun i => A ⧸ P i)
    (quotientProdEquivPi P hc) χ ψ hχ h

