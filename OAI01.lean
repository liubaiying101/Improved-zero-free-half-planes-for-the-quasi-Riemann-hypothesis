theorem first_dyadic_profile
    (K₀ y₀ d₀ f₀ E₀ t₀ c₀ x₁₀ x₂₀
      k y d f E t c x₁ x₂ : ℝ)
    (hK₀ : K₀ ≠ 0) (hy₀ : y₀ ≠ 0) (hd₀ : d₀ ≠ 0)
    (hf₀ : f₀ ≠ 0) (hE₀ : E₀ ≠ 0) (ht₀ : t₀ ≠ 0)
    (hc₀ : c₀ ≠ 0) (hx₁₀ : x₁₀ ≠ 0) (hx₂₀ : x₂₀ ≠ 0)
    (hk : 0 < k) (hy : 0 < y) (hd : 0 < d)
    (hf : 0 < f) (hE : 0 < E) (ht : 0 < t)
    (hc : 0 < c) (hx₁ : 0 < x₁) (hx₂ : 0 < x₂) :
