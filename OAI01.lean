  refine ⟨u, w * lam ^ 3, ?_, ⟨w, by ring⟩, ?_⟩
  · calc
      u * r + (w * lam ^ 3) * c₀ = u * r + w * (lam ^ 3 * c₀) := by ring
      _ = 1 := hbez
  · refine ⟨-w, ?_⟩
    linear_combination hbez

