    (norm_arithmeticDirichletTerm_le s h)

def arithmeticDirichletSeries (s : ℂ) (h : O) : ℂ :=
  ∑' c : LevelLower,arithmeticDirichletTerm s h c

def scatteringCoefficient (s : ℂ) (h : O) : ℂ :=
