    obtain ⟨u, hu⟩ := RayFourExpansion.prime_product_unit_mod_four p hc D
    change ‖χ (Ideal.Quotient.mk (Ideal.span {(4 : O)}) (∏ i ∈ D, p i))‖ = 1
    rw [← hu]
    exact FiniteRayExpansion.norm_char_unit χ u
