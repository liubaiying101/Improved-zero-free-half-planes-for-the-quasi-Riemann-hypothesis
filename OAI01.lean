    have hh := FirstCauchyArithmetic.supportMobius_sq (fun i => Ideal.span {p i})
      (fun i => Ideal.prime_of_isPrime (NeZero.ne (Ideal.span {p i})) inferInstance) hinj D
    have hh' := congrArg norm hh
    simp only [norm_mul, norm_one] at hh'
