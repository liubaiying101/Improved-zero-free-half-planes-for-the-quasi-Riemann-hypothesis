    star_supportMobius]
  calc
    _ = (star (columnCoefficient p hp hcop hg S) * convertedColumnBlock p hp hg S true) *
      (columnCoefficient p hp hcop hg T * convertedColumnBlock p hp hg T false) *
      (star (C₁ S) * C₂ T * supportMobius (fun i => Ideal.span {p i}) S *
