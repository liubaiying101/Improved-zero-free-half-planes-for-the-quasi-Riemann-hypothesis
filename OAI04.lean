theorem fourier_joint_stronglyMeasurable {α : Type*} [MeasurableSpace α]
    (f : α → ℝ → ℂ) (hf : StronglyMeasurable (Function.uncurry f)) :
    StronglyMeasurable (fun p : α × ℝ => (𝓕 (f p.1)) p.2) := by
