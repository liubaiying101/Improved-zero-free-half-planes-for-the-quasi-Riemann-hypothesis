    (hcop : Pairwise (Function.onFun IsCoprime Q))
    (hg : ∀ i, goodLambda ∉ Q i) (j : ι → ℕ)
    (hχ : ∀ i, actualSextic (Q i) (hg i) ^ j i ≠ 1)
    (W : 𝓢(ℝ, ℂ)) (M : ℝ) (hM : 0 < M) :
