    [Fintype a] [Fintype b] [Fintype c] [Fintype n]
    [DecidableEq a] [DecidableEq b] [DecidableEq n]
    (A : a → Ideal Eis) (B : b → Ideal Eis) (C : c → Ideal Eis)
    (cols : n → Ideal Eis) (hc : ∀ j, primaryGenerator (cols j) ≠ 0)
