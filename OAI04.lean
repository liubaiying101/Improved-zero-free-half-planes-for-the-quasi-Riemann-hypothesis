      (∀ i, |ρ i| ≤ B i) → 1 ≤ c₁ → 1 ≤ c₂ → c₁ ≤ b → c₂ ≤ b → 0 ≤ L →
      (∀ (θ₁ θ₂ : ℝ) (y : Fin 6 → ℝ),
        (Real.exp (-6*L) : ℂ) * secondPoissonProfile
