def width (s:NaturalState Z Bmask bΦ):ℝ := s.rowWidth+s.characterWidth
lemma width_nonneg (s:NaturalState Z Bmask bΦ):0≤s.width :=
  add_nonneg s.row_nonneg s.character_nonneg

