theorem continued_residue_pair_integrable {ι : Type*} (η : Character) (S : Finset Id)
    (hS : SourceExclusions S) (J : Finset ι) (T : ι → Finset _root_.OAI.SevenEighths.ProbePhysical.PrimeIdeal)
