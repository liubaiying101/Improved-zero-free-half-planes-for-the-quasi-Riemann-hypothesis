      (p.profile 0) (p.profile 1) X₁ X₂ s.radial :=
  (CenteredMomentCoreFloor.zero_energy_eq _ _ _ _ _ _ _ _ _).symm

lemma radical_bound (s:NaturalState Z Bmask bΦ):
    (s.puncture.radical.absNorm:ℝ)≤Z^Bmask :=by
