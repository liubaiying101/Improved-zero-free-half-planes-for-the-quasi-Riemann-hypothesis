      0≤δ → δ≤η → 0≤ε → (kK*QK)≤ Z^Lrow → (kP*QP)≤ Z^Lslot →
      Real.logb Z 16≤η → ε*(Lrow+Lslot+2*(δ+Lscale+η))+η/2≤π →
      let G := (poolPrimeFamily J Q Q₀).restrict A
