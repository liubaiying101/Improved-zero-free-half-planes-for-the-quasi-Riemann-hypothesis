    (hcount : 159*ε+εm+slotMesh+7*ν≤1/32)
    (hζ : 0≤ζ) (hζ' : ζ≤1/48) (hv : v≤ h+ζ)
    (hμ : 0≤μ) (hdv : d-v≤μ) (he : 0≤ e) (heps : 0≤ eps)
