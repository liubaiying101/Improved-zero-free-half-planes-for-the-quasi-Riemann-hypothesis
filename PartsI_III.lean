def D (x : ℝ) : ℝ := 3-17*x/9
def P (x : ℝ) : ℝ := (2-8*x/9)*(1-x)
def J (δ x : ℝ) : ℝ := (5/6-δ)*D x+δ*P x
def R (δ x : ℝ) : ℝ := 1-δ+(5/6-δ)*δ*P x/(2*J δ x)
def E (ℓ δ x : ℝ) : ℝ :=
