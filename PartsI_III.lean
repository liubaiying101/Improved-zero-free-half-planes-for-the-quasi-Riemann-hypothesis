    ∃J:ℕ,∃C:ℝ,0< C ∧ ∀{ι:Type*}(ζ:ι→ℂ)(height:ℝ),0≤ height →
      (∀i,(ζ i).re=17/50) → (∀i,|(ζ i).im|≤ height) → ∀i,
      S.sup (schwartzSeminormFamily ℝ ℝ ℂ) (slotSchwartz F (ζ i))≤ C*(1+height)^J := by
  obtain ⟨J,C,hC,hbound⟩:=slotSchwartz_uniform F S
