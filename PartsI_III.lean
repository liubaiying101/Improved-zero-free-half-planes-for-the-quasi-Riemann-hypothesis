lemma polynomial_height_absorption (C Z τ J t : ℝ)
    (hC : 0 ≤ C) (hZ : 1 ≤ Z) (hτ : 0 ≤ τ) (hJ : 0 ≤ J) (hbudget : 2*τ*(1+J) ≤ t) :
