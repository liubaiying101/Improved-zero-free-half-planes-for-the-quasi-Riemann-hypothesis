  have hi2 := (h2i .s t).1
  rw [v2_verticalIntegral_swap (fun z w => F ((a:ℂ)+t*I) w z) ξ 3 hiξ,
    v2_verticalIntegral_swap (fun z w => F ((a:ℂ)+t*I) w z) 2 3 hi2]
