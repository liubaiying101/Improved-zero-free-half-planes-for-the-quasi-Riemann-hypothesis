  linarith

/-- The distinct intermediate row range, using its own source exponent. -/
theorem intermediate_physical_margin (δ d q : ℝ)
    (_hδ : 0 ≤ δ) (hδ' : δ ≤ 5/6) (hq : q ≤ δ/2) (hd : d ≤ 1/2) :
