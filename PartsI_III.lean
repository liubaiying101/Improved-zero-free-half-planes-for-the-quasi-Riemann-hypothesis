    (a e : ℝ) (ha : a∈Icc (34999/40000:ℝ) 2) (hβ : HeckeZeroSupremum.beta< a)
    (he : 0< e) (hehi : e≤5/6) :
    ∃C : ℝ,0< C ∧ ∀(W : ι→ℝ→ℝ),
