      480≤ c*Z^(ell j) ∧ (Ideal.absNorm η.modulus:ℝ)< c*Z^(ell j) := by
  have hh : ∀ᶠZ : ℝ in atTop,∀j∈J,
      480≤ c*Z^(ell j) ∧ (Ideal.absNorm η.modulus:ℝ)< c*Z^(ell j) := by
    apply (Filter.eventually_all_finset J).mpr
    intro j hj
    have ht := (tendsto_rpow_atTop (hell j hj)).const_mul_atTop hc
