  obtain ⟨degree,C,ZC,hbound⟩ := perturbed_selected_nominal_energy lengthCap hL0 hL1 η S hS hbad ell hell hsum Ck b ε hCk hε hε1
  let C0 := ((Fintype.card RayRing:ℝ)+1)*Real.sqrt (C*B^2/q)/(2*Real.pi)
