theorem v2_principal_slot_eq_raw {Q : ℝ} {A η s : ℂ}
    (hQ : 480 ≤ Q) (hA : ‖A‖ ≤ 1) (hη : ‖η‖ ≤ 1) (hs : RHV2.boundary ≤ s.re) :
    principalSlot Q A η s =
