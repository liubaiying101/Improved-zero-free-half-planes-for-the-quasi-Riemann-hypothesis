theorem perturbed_low_physical_inverse_normalized (lengthCap x y : ℝ) (hxy : x+y=1-lengthCap) (hL0 : 0≤ lengthCap) (hL1 : lengthCap≤1/5) (η : HeckeFamily.Character) (S : Finset Id)
    (hS : ∀P∈S,P.IsMaximal) (hbad : fixedBadPrimes⊆S)
