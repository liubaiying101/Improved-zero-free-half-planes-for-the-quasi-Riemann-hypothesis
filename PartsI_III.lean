      perturbedRealLoss N v e eps loss mesh+overhead≤ boundary-11/16-saving := by
  have hδ : 0<2*a-1 := by linarith
  have hx : 0≤ q/(2*a-1) := div_nonneg hq hδ.le
  have hx' : q/(2*a-1)≤1/2 := (div_le_iff₀ hδ).mpr (by linarith)
