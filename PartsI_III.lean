    η θ (sourceFixedIdeal F) 1 (sourceFixedIdeal_le_modulus F) one_ne_zero u.property.1 hu

theorem source_energy_split (F : RHZeroFreeExtension.AnalyticHigh.SourceData D) (η : Character)
