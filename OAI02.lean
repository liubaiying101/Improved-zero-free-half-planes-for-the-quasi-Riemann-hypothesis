  have hF0:0<F:=zero_lt_one.trans_le hF
  have hQ:0≤Q:=by dsimp [Q,globalRayTripleConstant];positivity
  have hloss (j:GlobalLogIndex):0≤(globalBinLossScale B j)^ε:=by
    unfold globalBinLossScale
