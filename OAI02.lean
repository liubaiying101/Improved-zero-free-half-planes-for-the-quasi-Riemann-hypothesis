def coprimeSquarefreeRange (G : Ideal O) (K : ℝ) : Finset (Ideal O) :=
  (squarefreeIdealRange K).filter (fun H => IsCoprime H G)

theorem squarefree_cutoff_summable (K : ℝ) (f : Ideal O → ℂ) :
