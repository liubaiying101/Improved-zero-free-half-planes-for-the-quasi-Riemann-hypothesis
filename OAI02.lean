theorem positive_nested_density_transfer (f G : Frequency → ℝ) (J : ℕ)
    (hG : Continuous G) (M : ℝ) (hGM : ∀ q, ‖G q‖ ≤ M)
    (C : ℝ) (hf : ∀ q, 0 ≤ f q)
    (hbound : ∀ q, f q ≤ C*tripleLogDensity J q*G q) :
    (∫ x : ℝ, ∫ y : ℝ, ∫ z : ℝ,f (x,y,z)) ≤
      C*(∫ x : ℝ, ∫ y : ℝ, ∫ z : ℝ,tripleLogDensity J (x,y,z)*G (x,y,z)) := by
