    ‖fixedChildRow p hp hcop hg pool (normHeightTwist Ψ t) m
      (fun U=>g (columnLog p X U)) f y‖ := by
  rw [fixedChildRow_frequencyTwist p hp hcop hg pool Ψ m f y g X t hX,norm_mul,FourierBridge.logPhase_norm,one_mul]

