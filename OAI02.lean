      apply Finset.sum_le_sum
      intro j hj
      have hb:=globalBin_canonical_child_bound p hp hcop hg pool source side j Ψ m V₁ V₂ C E ε K ell B F A J
        hC hE hε hK hell hB0 hF0 hk hb₁ hb₂ (he j hj)
      apply hb.trans
