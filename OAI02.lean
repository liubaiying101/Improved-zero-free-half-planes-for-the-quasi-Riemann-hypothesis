  have hn : 3000-r+1≤3000-s := by omega
  have hn' : ((3000-r:ℕ):ℝ)+1≤((3000-s:ℕ):ℝ) := by exact_mod_cast hn
  unfold canonicalRankMargin
  nlinarith

theorem canonicalRatio_exp_loss (K M R : ℝ) (hM : 0<M) :
