  obtain ⟨ε,C,hε,hreg⟩ := actual_axis_local_regular s hs (Function.update p j t) ht j
  have h := hreg t (by simpa only [Function.update_self] using Metric.mem_ball_self hε)
  simp only [axisSlice_update] at h
  exact ⟨h.2.1,h.2.2.1⟩

