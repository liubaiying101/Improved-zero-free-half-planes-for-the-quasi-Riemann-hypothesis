    apply Finset.disjoint_left.mpr
    intro q hq hq'
    obtain ⟨C,hC,E,hE,he⟩:=by
      simpa only [Finset.mem_biUnion,Finset.mem_image] using hq
    obtain ⟨D,hD,F,hF,hf⟩:=by
