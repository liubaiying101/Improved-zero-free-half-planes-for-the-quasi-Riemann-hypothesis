  have h (j : Fin 3) := axisSlice_eventuallyEq_of_positive f g heq p hv j
  unfold axisLaplacian
  rw [(h 2).deriv_eq]
  congr 2
  apply Finset.sum_congr rfl
  intro j hj
  exact (h j).deriv.deriv_eq

