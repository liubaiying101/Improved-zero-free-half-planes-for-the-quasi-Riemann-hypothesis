lemma fullCuspProfileSum_eq_single (F : ℝ→ℝ) (hF : ∀v≤1,F v=0)
    (w : HyperbolicSpace) (x : FullCuspClasses) (hx : 1<fullCuspHeight x w) :
    fullCuspProfileSum F w=F (fullCuspHeight x w) := by
  apply tsum_eq_single x
