theorem primeSupport_inverse_sum (s : Finset (Finset ι)) (U : ℝ)
    (hs : ∀S∈s,primeProductNorm p S≤U) :
    (∑S∈s,1/primeProductNorm p S)≤128*Real.exp 1*(normLogBin U+1 : ℝ) := by
  let f := fun S : Finset ι => ∏i∈S,(Ideal.span {p i} : Ideal O)
