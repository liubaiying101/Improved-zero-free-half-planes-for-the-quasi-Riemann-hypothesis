theorem globalSecondTuple_cube_eq {x y : GlobalSecondData ι}
    (hx : x.cube.Admissible) (hy : y.cube.Admissible)
    (h : globalSecondTuple p x=globalSecondTuple p y) : x.cube=y.cube := by
