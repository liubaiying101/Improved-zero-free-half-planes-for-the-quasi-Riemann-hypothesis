theorem firstCoreModeProfile_norm (g V : 𝓢(ℝ, ℂ)) (negative : Bool) (t s : ℝ) :
    ‖firstCoreModeProfile g V negative t s‖ = ‖g s‖ * ‖V s‖ := by
  rw [firstCoreModeProfile_apply]
