      (hray x)).trans (reflectionSixInactiveWeight_norm_le_one I F Q x.2)

theorem sixPhaseFixedCuspFiber_value (rays:ℕ) (I F Q:Ideal Eis) (hI:I≠0) (hQ:Q≠0)
