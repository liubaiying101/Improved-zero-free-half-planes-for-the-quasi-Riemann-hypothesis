      w 0*(Ideal.absNorm (Ideal.span {p}):ℂ)^2*((Ideal.absNorm (Ideal.span {p}):ℂ)-1)+w 3 := by
  simp_rw [cubeStratumSymbol_sum p C hp hprimary hC]
