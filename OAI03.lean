lemma kernelFunctionCutoff_uniform_near (f : KernelQuotient→ℂ)
    (hf : ContMDiff 𝓘(ℝ,SpatialCoordinates) 𝓘(ℝ,ℂ) ∞ f)
    (K : Set KernelQuotient) (hK : IsCompact K) :
