    ((cubeAverage_continuous p hp F hF).comp (cube_upperPoint_continuous v hv)).mul (cusp_character_continuous h)
  have hHperiod (n:Eis) (z:ℂ):H (z+3*eisEmbedding n)=H z:=by
    dsimp [H]
