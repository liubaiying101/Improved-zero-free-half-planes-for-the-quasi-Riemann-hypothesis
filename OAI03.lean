  have hA : (a:ℂ)^(1/2-s)=(a:ℂ)^(1/2:ℂ)*(a:ℂ)^(-s) := by
    rw [sub_eq_add_neg,Complex.cpow_add _ _ ha0]
  have hB : (b:ℂ)^(3*(1/2-s))=(b:ℂ)*(b:ℂ)^(1/2-3*s) := by
    rw [show (3:ℂ)*(1/2-s)=1+(1/2-3*s) by ring,
      Complex.cpow_add _ _ hb0,Complex.cpow_one]
  rw [hA,hB]
  field_simp

