    ∫z in periodDomain,ramifiedSourceFunction (ramifiedCuspRoot b:Eis)
      (upperPoint z v hv)*ShortDraftTrace.breveE (-ninthCuspFrequency h*z) := by
  have he (z : ℂ) : -ninthCuspFrequency h*(3*z)= -cuspFrequency h*z := by
