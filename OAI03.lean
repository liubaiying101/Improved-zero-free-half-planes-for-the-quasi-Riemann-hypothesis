        ShortDraftTrace.breveE (-cuspFrequency (h*p^3)*z) := by
  let V:=v/‖eisEmbedding p‖^3
  have hV:0<V:=div_pos hv (pow_pos (norm_pos_iff.mpr (eisEmbedding_ne_zero hp)) 3)
