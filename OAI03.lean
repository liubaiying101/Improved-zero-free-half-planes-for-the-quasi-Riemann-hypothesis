        ((9*Real.sqrt 3/2:ℝ):ℂ) := by
  rw [scatteringCoefficient_unramified_gauss s hs h hh]
  congr 1
  apply tsum_congr
  intro u
  apply Finset.sum_congr rfl
  intro n hn
  rw [arithmeticResidueSum_eq_explicitRamifiedCoefficient h u (n+2) (by omega)]

