theorem ramifiedSource_scaled_fourier_active (b : Bool) (h : Eis)
    (hh : (3:Eis)∣h-onceCuspScale (ramifiedCuspScaleUnit b)) (v : ℝ) (hv : 0<v) :
    (∫z in periodDomain,ramifiedSourceFunction (ramifiedCuspRoot b:Eis)
