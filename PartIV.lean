theorem source_batch_plain_unmarked (D:RHZeroFreeExtension.AnalyticHigh.IV.HighData Δ)
    (S:RHZeroFreeExtension.AnalyticHigh.IV.SourceData D)
    (henergy:∃degree:ℕ,∃control:Finset (ℕ×ℕ),∀Q:Ideal O,
