  have hb := B.card_bound (fiberConstant C height K₀)
    (fun _=> max (RHBootstrapCount.shortCount (2/(3*k)) (2*a-1) (q/(2*a-1)) tstar) (RHBootstrapCount.longCount (5/6) (2*a-1) tstar)+
      159*ε+εm+B.mesh+7*ν)
