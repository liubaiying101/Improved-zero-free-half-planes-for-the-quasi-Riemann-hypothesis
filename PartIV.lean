theorem source_batch_plain_marked_fine {Δ:ℝ}{D:RHZeroFreeExtension.AnalyticHigh.IV.HighData Δ}
    (S:RHZeroFreeExtension.AnalyticHigh.IV.SourceData D)(mesh:ℝ)(hmesh:0< mesh)(hfine:∀j,D.ell j≤ mesh/200)
