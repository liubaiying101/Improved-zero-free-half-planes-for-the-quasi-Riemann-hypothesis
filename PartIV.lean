  have hAmax:0< Amax:=by dsimp [Amax];linarith
  have hA_bound (label):A label≤ Amax:=by
    have hh:=Finset.single_le_sum (fun j (_:j∈Finset.univ)=>(hA j).le) (Finset.mem_univ label)
    dsimp [Amax];linarith
