theorem iv_selected_norm_bound (η : Character) (S : Finset Id) (hS : CorrectionTail S)
    (T : Finset OAI.SevenEighths.ProbePhysical.PrimeIdeal) (hT : ∀ P ∈ T, P.val ∉ S) (x w z : ℂ) (Bx Bz : ℝ)
