theorem fine_moment_input_of_previous_bound
    (hOld : HeckeZeroSupremum.beta ≤ (1+RHIVProbe.momentKappa)/2) : FineMomentInput := by
  intro hBeta
  have hgap : 0< HeckeZeroSupremum.beta-RHIVProbe.boundary := sub_pos.mpr hBeta
