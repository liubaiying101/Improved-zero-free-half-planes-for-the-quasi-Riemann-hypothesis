theorem sourceData_batch_gate {Δ : ℝ} {D : RHZeroFreeExtension.AnalyticHigh.IV.HighData Δ}
    (F : RHZeroFreeExtension.AnalyticHigh.IV.SourceData D) (η : Character) :
    ∀ᶠZ : ℝ in atTop,∀d : ℝ,d≠0→∀a ε tstar T allowance : ℝ,∀i : ℕ,
