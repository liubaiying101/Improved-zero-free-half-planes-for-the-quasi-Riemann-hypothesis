def geometry (t : ℝ) (ht : InInterval t) : RHIVProbe.Geometry where
  b := b t
  ell := ell t
  b_lo := (b_lower t ht).le
  b_hi := (b_upper t ht).le
  ell_lo := (ell_box t ht).1.le
  ell_hi := (ell_box t ht).2.1.le

