    0≤ R delta u+countLoss+delta/2-17/50 ∧ R delta u+countLoss+delta/2-17/50≤2 at hr
  have hslo : 0≤ R delta u+countLoss+delta/2-(17/50:ℝ) := hr.2.2.1
  have hshi : R delta u+countLoss+delta/2-(17/50:ℝ)≤2 := hr.2.2.2
