theorem fixed_window_data (S:RHZeroFreeExtension.AnalyticHigh.IV.SourceData D):
    Function.support (fun x=> conj (S.W x))⊆Set.Icc (1:ℝ) 2 ∧
    ContDiff ℝ ∞ (fun x=> conj (S.W x)) ∧ ∀x,‖conj (S.W x)‖≤1 := by
