    let K0 := fun s=> sourceMultiplier W0 W1 (Z^(RHIVProbe.x:ℝ)) (Z^(RHIVProbe.y:ℝ)) Z
      (η.excludePrimes S hS.prime) s (globalClosedCorrection η S s)
