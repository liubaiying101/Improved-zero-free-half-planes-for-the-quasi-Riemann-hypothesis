    hU ha hd hε hε' ht.1 ht.2 hk hk' hν hC hh hf B hq hmom
  have he : max (RHBootstrapCount.shortCount (2/(3*k)) (2*a-1) (q/(2*a-1)) (cutoff k (2*a-1) q))
