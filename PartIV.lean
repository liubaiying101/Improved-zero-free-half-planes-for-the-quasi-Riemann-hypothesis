lemma iv_eventually_compensated_source_scales (C : CalibrationData) (B : ℝ) :
    ∀ᶠ Z : ℝ in Filter.atTop,1≤ Z ∧ elementNorm C.generator≤ Z^(RHIVProbe.b:ℝ) ∧
      ∀L : ℝ,1≤ L→L≤ B*Z^(RHIVProbe.ell:ℝ)→
