theorem slotSchwartz_uniform (F:RHZeroFreeExtension.AnalyticHigh.IV.SourceData D)(S:Finset (ℕ×ℕ)):
    ∃J:ℕ,∃C:ℝ,0< C ∧ ∀ζ:ℂ,ζ.re∈Set.Icc (0:ℝ) 1 →
