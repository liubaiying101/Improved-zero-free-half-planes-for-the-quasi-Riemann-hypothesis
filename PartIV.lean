  have hmul := mul_le_mul_of_nonneg_right hdv (show 0≤ R delta u+countLoss by linarith [hr.1])
  have hmax := mul_le_mul_of_nonneg_left (show R delta u+countLoss≤3/2 by linarith [hr.2.1]) hmu
