    rw [IVAdaptiveCutoff.cutoff_eq_balanced k (2*a-1) q hδ hd hqb.1 hqb.2]
    exact IVAdaptiveCutoff.balanced_count_identity k (2*a-1) (q/(2*a-1)) hk hδ.le hd hx hx'
  rw [he] at hc'
  exact hc'

theorem high_adaptive_count_from_raw_moments
