    (hOld : HeckeZeroSupremum.beta ≤ (1+RHIVProbe.momentKappa)/2) :
    HeckeZeroSupremum.beta ≤ RHIVProbe.boundary :=
  RHIVProbe.beta_star_le_of_probes (physical_probe_estimates_of_previous_bound hOld)
