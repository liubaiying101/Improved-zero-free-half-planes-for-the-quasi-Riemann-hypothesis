theorem iv_prime_coprime_of_norm_gt (η : Character) (P : OAI.SevenEighths.ProbePhysical.PrimeIdeal)
    (hN : Ideal.absNorm η.modulus < Ideal.absNorm P.val) : IsCoprime P.val η.modulus := by
