    (hu0 : 0 ≤ u) (hu1 : u ≤ 1/2) (ht0 : 1 ≤ t) (ht1 : t ≤ 3/2) :
    1/3 ≤ t-rstar c u t ∧ t-rstar c u t ≤ 1/2 := by
