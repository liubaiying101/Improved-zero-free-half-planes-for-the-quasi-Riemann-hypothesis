def rstar (c u t : ℝ) : ℝ := ((2-c*u)*t+(c/2-1)*u)/D c u
def invGain (u r : ℝ) : ℝ := u+(1-u)*r
def plainGain (c u t r : ℝ) : ℝ := 2*(t-r)+(c/2)*u*(1-2*(t-r))

lemma D_pos (c u : ℝ) (hc0 : 0 < c) (hc1 : c < 1)
