      have hh : Z^((6+3*RHIVProbe.ell):ℝ)*Z^(2:ℝ)=Z^((8+3*RHIVProbe.ell):ℝ) := by rw [←Real.rpow_add hZ0]; congr 1; ring
      rw [←hh]
