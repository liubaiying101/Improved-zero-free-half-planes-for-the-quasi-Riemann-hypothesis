theorem eventually_source_relativeBase_gate (F : RHZeroFreeExtension.AnalyticHigh.IV.SourceData D) (η : Character) :
    ∀ᶠZ : ℝ in atTop,∀label : Sum Bool (RayQuotient.Characters F.modulus ⊤),
