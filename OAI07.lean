        radicalBound (childCharacter η χ) fixedBadMask p (errorMovingExponent n)) ∧
      ∀ (S : Finset (Ideal O)) (u : O) (C : Ideal O) (β : Ideal O → ℂ) (t : ℝ) (z : O),
