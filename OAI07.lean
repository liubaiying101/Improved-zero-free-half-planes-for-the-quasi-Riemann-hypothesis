    (sourceGenerator_supported (residualColumns S p hp (n+1))) c z)
  funext I
  rw [residual_column_active S p hp hs n hn I (Finset.mem_filter.mp I.property).1]

lemma paired_gauss_rows (η τ₁ τ₂ : Character) (F₁ F₂ : O → ℂ)
